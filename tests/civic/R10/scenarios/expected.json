  {"cases": ["g1-offset-plus05", "g1-offset-z", "g1-offset-plus06"], "why": "the same analysis instant written as +05:00, Z and +06:00 must give identical routes"},
  {"cases": ["g1-permutation-1", "g1-permutation-2"], "why": "order of closures, of edge_ids inside a closure and of plans must not change routes"}
 ],
 "repeat_case": {"case": "g1-detour", "why": "two independent calls with identical input must return identical output (input mutation itself is only observable in-process; R10 runs compare() in a fresh subprocess per call, so mutation is NOT_RUN here)"},
