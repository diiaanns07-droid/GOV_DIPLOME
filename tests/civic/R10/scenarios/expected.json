{
 "schema": "r10-civic-scenario-expected-v1",
 "about": "R10 hand-computed expectations for engine.civic_scenarios compare(payload, graph) on scenarios/tiny_graphs.json. Every number was derived by hand from the edge list (see 'derivation'); scenarios/bruteforce.py (exhaustive simple-path DFS, not Dijkstra) re-derives them in test_scenarios_tinygraph.py self-checks.",
 "graphs_file": "tiny_graphs.json",
 "length_tolerance_m": 0.01,
 "placeholders": {"$GRAPH_DIGEST": "replaced by the 'digest' field of the graph object actually passed to compare() (after graph_patch)"},
 "pair_key": "'<origin_node_id>>' + '<destination_node_id>'",
 "entry_fields": {
  "status": "ok | unreachable | unknown (strict policy: only access=allowed edges make an ok route)",
  "length_m": "network length in metres for ok, null otherwise",
  "path_edges": "one shortest path written by hand (edge ids in travel order); for tie=true any equal-length path is acceptable",
  "tie": "true when two or more different paths share the minimal length: assert the length only, never the path",
  "also_acceptable": "extra statuses the contract does not exclude (denied-only target may be reported unknown, never ok)"
 },
 "window_note": "Unless stated otherwise closures use [2026-10-15T08:00:00+05:00, 2026-10-15T18:00:00+05:00) and analysis_at 2026-10-15T09:00:00+05:00 (Astana is UTC+05:00 since 2024; offsets are always explicit).",
