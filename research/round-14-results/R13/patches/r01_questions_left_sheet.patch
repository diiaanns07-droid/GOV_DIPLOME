diff --git a/web/civic/shell/birge.css b/web/civic/shell/birge.css
index b4b030f6..9b0ae1b4 100644
--- a/web/civic/shell/birge.css
+++ b/web/civic/shell/birge.css
@@ -891,3 +891,33 @@ body.civic-mode:has(#birge-legend[data-open="true"], #birge-layer-btn[aria-expan
   body.civic-mode #birge-heat-root :is(.r07-error, .r07-empty) .bk-ill { width: 48px; height: 40px; margin-bottom: 0; }
   body.civic-mode #birge-heat-root .r07-error .r07-btn { margin-top: 4px; }
 }
+
+/* Эталон A (13 окт, R13 INTEGRATION §12.1): «Вопрос акиму» — лист слева, как «Проекты и идеи» эталона: ширина 412
+   (--sheet-w), 20 от края, под строкой поиска (84), 20 снизу, радиус 18, плотное стекло 86 % (.glass.strong) с цветами
+   текста .bk-glass--strong. Шапка листа стоит, прокручивается список (правила списка — qa.css). Справа видна карта. Запасной непрозрачный вид не меняется: фон задан переменной --glass-panel,
+   а запасные правила ui-kit ставят белый напрямую. Телефон — шторка от края до края (ниже). */
+@media (min-width: 761px) {
+  body.civic-mode[data-birge-section="questions"] .birge-day.bk-glass {
+    left: 20px; right: auto; top: 84px; bottom: 20px; width: min(var(--sheet-w, 412px), calc(100vw - 40px));
+    padding: 0; border-radius: var(--r-xl, 18px);
+    --glass-panel: var(--glass-strong, rgba(255, 255, 255, 0.86));
+    --c-text-2: #4b5752; --c-text-3: #7e8a85; --c-warn: #754c0f; --c-ok: #2b6110; --c-danger: #9a2e28;
+  }
+  /* шапка и сегменты стоят, прокручивается только список (эталон .psheet — колонка, .list — overflow: auto) */
+  body.civic-mode[data-birge-section="questions"] .birge-day.bk-glass:not([hidden]) { display: flex; flex-direction: column; overflow: hidden; }
+  body.civic-mode[data-birge-section="questions"] .birge-screen-root { display: flex; flex: 1; flex-direction: column; min-height: 0; }
+  body.civic-mode[data-birge-section="questions"] .birge-screen-root > .qa { max-width: none; }
+}
+/* Телефон: шторка во всю ширину от края до края (эталон, телефон: радиус 26 сверху, поля 18), под капсулой шапки (72);
+   ручки нет — шторка не перетаскивается. Шапка листа так же стоит, прокручивается список. */
+@media (max-width: 760px) {
+  body.civic-mode[data-birge-section="questions"] .birge-day.bk-glass {
+    left: 0; right: 0; bottom: 0; padding: 0;
+    border-radius: var(--r-glass-sheet, 26px) var(--r-glass-sheet, 26px) 0 0;
+    --glass-panel: var(--glass-strong, rgba(255, 255, 255, 0.86));
+    --c-text-2: #4b5752; --c-text-3: #7e8a85; --c-warn: #754c0f; --c-ok: #2b6110; --c-danger: #9a2e28;
+  }
+  body.civic-mode[data-birge-section="questions"] .birge-day.bk-glass:not([hidden]) { display: flex; flex-direction: column; overflow: hidden; }
+  body.civic-mode[data-birge-section="questions"] .birge-screen-root { display: flex; flex: 1; flex-direction: column; min-height: 0; }
+  body.civic-mode[data-birge-section="questions"] .birge-screen-root > .qa { --qa-px: 18px; --qa-pb: 18px; }
+}
