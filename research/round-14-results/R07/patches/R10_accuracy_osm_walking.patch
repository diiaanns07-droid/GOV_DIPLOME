+def load_walking_nodes(root: Path):
+    """Узлы снимка пешеходной сети OSM (osm-walking): {id: [lon, lat]}. Из него R07 берёт светофоры, переходы и
+    перекрёстки (волна 1, п. 12) — в LOCAL-1 (osm-objects) их нет."""
+    f = root / OSM_WALKING
+    if not f.exists():
+        return None
+    data = json.load(gzip.open(f, "rt", encoding="utf-8"))
+    return {el["id"]: [el["lon"], el["lat"]] for el in data.get("elements", []) if el.get("type") == "node"}
