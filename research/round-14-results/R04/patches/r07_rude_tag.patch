+def _rude(text: str) -> bool:
+    """Есть ли грубые слова (фильтр R04 ui.civic_ml_api.profanity); фильтр недоступен — False."""
+    try:
+        from ui.civic_ml_api.profanity import is_rude
+    except Exception:
+        return False
+    return is_rude(text)
