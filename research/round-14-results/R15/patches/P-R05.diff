+  // R15-S16: id устройства — не только голос: тепловая карта R07 перенимает его как «birge.device», а по нему форма
+  // R09 открывает «Мои обращения» с текстами жалоб. Поэтому только криптографически случайный (как у R06 и R09),
+  // а не время + Math.random (их можно восстановить). Формат прежний: dev-<24 символа>.
+  function randomToken(n) {
+    var abc = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";
+    var c = typeof globalThis !== "undefined" ? globalThis.crypto : null;
+    var bytes = new Uint8Array(n);
+    if (c && typeof c.getRandomValues === "function") c.getRandomValues(bytes);
+    else for (var i = 0; i < n; i++) bytes[i] = Math.floor(Math.random() * 256);
+    var out = "";
+    for (var j = 0; j < n; j++) out += abc[bytes[j] % abc.length];
+    return out;
+  }
