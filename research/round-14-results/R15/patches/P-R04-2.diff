 # --------------------------------------------------------------------------- JSON-ответы API
 # Ключи, под которыми только геометрия и числа: их не обходим (ответ тепловой карты — в основном координаты).
-_SKIP_KEYS = frozenset({"geometry", "coordinates", "bbox", "point", "points"})
+_SKIP_KEYS = frozenset({"geometry", "coordinates", "bbox", "point", "points",
+                        # R15-S26: машинные строки — не текст людей. В случайных символах base64 фото, CSRF-токена,
+                        # номера квитанции и id часто попадается «грубое» латинское сочетание: звёздочки ломают фото
+                        # (13 из 20 по 300 КБ) и токены (вход сотрудника, квитанция, «Мои обращения»).
+                        "data_url", "csrf_token", "receipt", "code", "id", "device_id", "token", "url", "href", "src",
+                        "sha256", "mime"})
+# R15-S26: data URL в списке без ключа (только base64 — пробелов и кириллицы в нём быть не может). Других правил по
+# значению нет: «длинное латинское слово» или «начинается с http» обходили бы фильтр в подписях идей и вопросах.
+_DATA_URL = re.compile(r"data:[a-z]+/[a-z0-9.+-]+;base64,[A-Za-z0-9+/]*={0,2}")
+
+
+def _skip_key(key) -> bool:
+    """Новые машинные поля — в _SKIP_KEYS или с окончанием *_id, *_ids, *_url, *_token."""
+    return key in _SKIP_KEYS or (isinstance(key, str) and key.endswith(("_id", "_ids", "_url", "_token")))
+
+
