      "city": "astana",
      "constraints": null
     }
    },
    {
     "text": "В районе Байконур усилить освещение и видеонаблюдение, а городскую программу озеленения не включать.",
     "context_city": null,
     "intended_class": "ok_city_inferred_from_district_astana_include_exclude",
