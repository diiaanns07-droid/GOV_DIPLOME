        }
       ],
       "budget": 120
      }
     }
    },
    {
     "text": "Есіл ауданындағы аулаларға спорт алаңдарын орнатайық.",
     "context_city": null,
     "intended_class": "ok_context_null_district_identifies_astana",
     "gold": {
      "status": "ok",
      "reason": null,
      "city": "astana",
      "constraints": {
       "exclude": [],
       "include": [
        {
         "measure": "M9",
         "district": "esil"
        }
       ],
       "budget": null
      }
     }
    },
    {
     "text": "Шымкенттегі Әл-Фараби ауданында көше жарығын күшейтіп, бейнебақылау камераларын көбейту керек.",
     "context_city": "astana",
     "intended_class": "ok_text_city_overrides_context",
     "gold": {
      "status": "ok",
      "reason": null,
      "city": "shymkent",
      "constraints": {
       "exclude": [],
       "include": [
        {
         "measure": "M10",
         "district": "al_farabi"
        }
       ],
       "budget": null
      }
     }
    },
    {
     "text": "Қаратау ауданындағы жеке үйлерді көмірден газға көшіріңіз, ал қалалық көгалдандыру бағдарламасын алып тастаңыз.",
     "context_city": "shymkent",
     "intended_class": "ok_shymkent_include_district_exclude_city_measure",
     "gold": {
      "status": "ok",
      "reason": null,
      "city": "shymkent",
      "constraints": {
       "exclude": [
        "M6"
       ],
       "include": [
        {
         "measure": "M5",
         "district": "karatau"
        }
       ],
       "budget": null
      }
     }
    },
    {
     "text": "Абай ауданында мектеп маңындағы жаяу жүргінші өткелдерін қауіпсіз етіп, бүкіл қала бойынша ТКШ апаттық бригадалары мен ерте хабарлау жүйесін енгізіңіз. Бюджет жетпіс бес бірлік.",
     "context_city": null,
     "intended_class": "ok_composite_context_null_district_identifies_shymkent_budget_words",
     "gold": {
      "status": "ok",
      "reason": null,
      "city": "shymkent",
      "constraints": {
