        }
       ],
       "budget": null
      }
     }
    },
    {
     "text": "ЛРТ желісін кеңейтуді жоспардан алып тастаңыз, бюджет — 60 бірлік.",
     "context_city": "astana",
     "intended_class": "ok_exclude_budget_digits",
