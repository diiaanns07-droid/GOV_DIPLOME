+def attribution_of(layers):
+    """Provider/licence pairs from sources[] of every delivered layer (places, segments, connectors)."""
+    pairs = Counter()
+    for fc in layers.values():
+        for f in fc["features"]:
+            for s in f["properties"].get("sources") or []:
+                pairs[(s.get("dataset"), s.get("license"))] += 1
+    lines = sorted({f"{ATTR_NAMES.get(d, d)} ({l})" for d, l in pairs})
+    return lines, sorted({l for _, l in pairs if l}), {f"{d}|{l}": n for (d, l), n in sorted(pairs.items())}
+
+
+def write_license_files(cities):
+    """Copy SPDX texts into web/LICENSES/ (byte copy, sha256 checked) and write web/ATTRIBUTION.md."""
+    needed = sorted({l for c in cities.values() for l in c["licenses"]})
+    out = APP / "web" / "LICENSES"
+    out.mkdir(parents=True, exist_ok=True)
+    for l in needed:
+        src = ATTR_SRC / "LICENSES" / f"{l}.txt"
+        if not src.exists():
+            raise InputError(f"нет текста лицензии {rel(src)} — запустите tools/copy_inputs.py")
+        b = src.read_bytes()
+        if l in LICENSE_SHA256 and hashlib.sha256(b).hexdigest() != LICENSE_SHA256[l]:
+            raise InputError(f"{rel(src)}: sha256 не совпадает с SPDX @31ba1a50")
+        (out / f"{l}.txt").write_bytes(b)
+    L = ["# Атрибуция и лицензии демо «Городские данные: Шымкент / Астана»", "",
+         "Данные — вторичные открытые данные Overture Maps (выпуск указан в карточке «Источники»), "
+         "срез двух квадратов 2×2 км, не официальный и не полный реестр города.", "",
+         "Строки построены по полю `sources[]` каждой записи (dataset, license). Это указание лицензии в записи, "
+         "а не юридическая проверка; рекомендованные формулировки поставщиков не сверялись.", ""]
+    for c in cities.values():
+        L.append(f"## {c['label']}")
+        L.append("")
+        for k, n in c["source_counts"].items():
+            d, l = k.split("|")
+            L.append(f"- {ATTR_NAMES.get(d, d)} — {l} — записей sources: {n}")
+        L.append("")
+    L += ["## Тексты лицензий", ""] + [f"- [{l}](LICENSES/{l}.txt)" for l in needed]
+    L += ["", "Тексты — побайтные копии SPDX license-list-data @31ba1a50 (пакет K08 R4, `inputs/k08_attr/`).",
+          "", "Условия OpenStreetMap: https://www.openstreetmap.org/copyright (ссылка по практике OSM; страница из среды сборки не открывалась).", ""]
+    (APP / "web" / "ATTRIBUTION.md").write_text("\n".join(L), encoding="utf-8")
+
