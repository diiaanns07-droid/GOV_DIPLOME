diff --git a/prototypes/city-evidence/run-demo.bat b/prototypes/city-evidence/run-demo.bat
new file mode 100644
index 0000000..72702cc
--- /dev/null
+++ b/prototypes/city-evidence/run-demo.bat
@@ -0,0 +1,11 @@
+@echo off
+rem Windows launcher for the city-evidence demo (stdlib Python only). Usage: run-demo.bat [port]
+setlocal
+cd /d "%~dp0"
+set PYTHONUTF8=1
+where py >nul 2>nul
+if %errorlevel%==0 (
+  py -3 serve.py %*
+) else (
+  python serve.py %*
+)
