+# ---- round-6 adapter (K06): BUILD 064ed25 renamed evidence indicators and count labels -------------------
+# Old schema (0bf27de): places.total, places.<g>, capacity.school_places, registry.official_schools, population.children
+# New schema (064ed25): overture_place_records.<g>.conf_ge_0_0, overture_place_records.city_total (null),
+#                       official_registry.schools, capacity.school_places, population.children
+UNKNOWN_IDS = (("capacity.school_places",), ("registry.official_schools", "official_registry.schools"),
+               ("population.children",))
+
+
+def group_obs(obs, g):
+    return obs.get("places." + g) or obs.get(f"overture_place_records.{g}.conf_ge_0_0")
+
+
+def total_obs(obs, groups):
+    """(value, unit, kind, coverage) of the slice total, from either schema."""
+    if "places.total" in obs:
+        o = obs["places.total"]
+        return o["value"], o.get("unit"), o["kind"], o.get("coverage") or {}
+    gs = [group_obs(obs, g) for g in groups]
+    return sum(o["value"] for o in gs), gs[0].get("unit"), gs[0]["kind"], gs[0].get("coverage") or {}
+
+
+def city_total_unknown(obs):
+    """New schema states the city total explicitly; it must be null and not complete. Old schema: n/a (True)."""
+    o = obs.get("overture_place_records.city_total")
+    return True if o is None else (o["value"] is None and (o.get("coverage") or {}).get("complete") is False)
+
+
+NEG = re.compile(r"(?:\bне\b|\bнет\b|\bа не\b)[^.;:!?«»]{0,40}$")
+
+
+def affirmative_claims(pattern, text):
+    """Matches of pattern that are NOT inside a negation like '…, а не отсутствие объектов в городе'."""
+    return [m.group(0) for m in re.finditer(pattern, text) if not NEG.search(text[max(0, m.start() - 60):m.start()])]
+
+
+SCOPE_PHRASES = ("в срезе", "по квадрату", "в квадрате")   # count is limited to the 2x2 km slice
+
+
