+def _astana_date(ts: str) -> _dt.date:
+    moment = _dt.datetime.strptime(ts, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=_dt.timezone.utc)
+    return (moment + _dt.timedelta(hours=5)).date()          # Астана: UTC+5
