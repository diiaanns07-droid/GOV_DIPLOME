{
  "version": "r03-emergency-v1",
  "created": "2026-10-11",
  "note": "Правила «срочно — позвоните» по тексту жалобы (POLISH_WAVE п. 3, владелец R09). Модель v2 тут ни при чём: это отдельное правило. Один файл для Python (ml/civic_classifier_v2/emergency.py) и JS (R09). Проверка: tests/civic/R03/round14/emergency_cases.json, разбор — results/EMERGENCY_KEYWORDS.md.",
  "how_to_use": [
    "1. Нормализовать текст: в нижний регистр, ё -> е, любые пробельные символы -> один пробел.",
    "2. Во всех строках re/veto/except заменить {B}, {E}, {L} на значения из defs (простая замена подстроки).",
    "3. Каждое выражение из except заменить в тексте на пробел (глобально, флаг g в JS).",
    "4. Правило срабатывает, если его re нашлось в тексте после шага 3, а veto (если есть) не нашлось во всём тексте после шага 3.",
    "5. kind правила -> category/subtopic из kinds -> телефон берётся из categories_v2.json (emergency_phone уточнения), не из этого файла.",
    "Без флагов: текст уже в нижнем регистре. Нет \\b (в JS он только для латиницы) и нет просмотра назад (?<= (?<! — нет в старом Safari). Просмотр вперёд (?! есть везде."
  ],
  "defs": {
    "L": "[a-zа-яеәғқңөұүһі]",
    "B": "(?:^|[^a-zа-яеәғқңөұүһі0-9])",
    "E": "(?![a-zа-яеәғқңөұүһі0-9])"
  },
  "kinds": {
    "gas": {"category": "smell_air", "subtopic": "gas"},
    "fire": {"category": "smell_air", "subtopic": "smoke_fire"},
    "wire": {"category": "lighting", "subtopic": "wire_down"}
  },
  "except": [
    {"id": "fire_service_words", "re": "(?:противо)?пожар(?:н|оопас|обезопас){L}*", "why": "пожарная машина/проезд/гидрант, пожароопасно — не идущий пожар (жалобы на парковку)"},
    {"id": "kk_fire_service", "re": "өрт (?:сөндір|қауіпсіздіг|қауп){L}*", "why": "өрт сөндіру көлігі, өрт қауіпсіздігі — пожарная машина, пожарная безопасность"},
    {"id": "not_burning_ru", "re": "не (?:горит|горят|горел|горела|горело|горели|загора{L}*|загорел{L}*)", "why": "«не горит фонарь» — освещение, не огонь"},
    {"id": "not_burning_translit", "re": "ne gor{L}*", "why": "то же транслитом"},
    {"id": "exhaust_ru", "re": "выхлоп{L}* газ{L}*|газ{L}* от (?:машин|авто|транспорт|завод|тэц|предприят){L}*", "why": "выхлопные газы — запах и воздух, не утечка"}
  ],
  "rules": [
    {"id": "gas_ru", "kind": "gas", "re": "{B}газ(?:а|у|ом|е)?{E}", "why": "газ, запах газа, пахнет газом; не газон/газель/газета/газировка"},
    {"id": "gas_kk", "kind": "gas", "re": "{B}газ(?:ы|дың|ды|дан|ын)?{E}", "why": "газ иісі, газы шығып тұр"},
    {"id": "gas_adj_ru", "kind": "gas", "re": "{B}газов(?:ая|ой|ую|ый|ого|ом|ые|ых) (?:труб|плит|колонк|кот[её]?л|баллон|счетчик|кран|шланг|стояк|оборудован){L}*", "why": "газовая труба/плита/колонка"},
    {"id": "gas_pipe", "kind": "gas", "re": "{B}газопровод{L}*", "why": "газопровод"},
    {"id": "gas_translit", "kind": "gas", "re": "{B}gaz(?:a|u|om|e)?{E}", "why": "pahnet gazom"},

    {"id": "fire_word_ru", "kind": "fire", "re": "{B}пожар(?:а|е|ом|у|ы|ов)?{E}", "why": "пожар (после except: не «пожарная машина»)"},
    {"id": "fire_ignition_ru", "kind": "fire", "re": "{B}(?:возгоран{L}*|пламя|пламени|открытый огонь)", "why": "возгорание, пламя; «огонь» один не берём — сленг «сквер огонь»"},
    {"id": "fire_object_ru", "kind": "fire", "re": "(?:горит|горят|загорел{L}*|полыхает|полыхают|пылает|дымит) (?:мусор|бак|контейнер|трав|дом|квартир|подъезд|гараж|машин|автомобил|балкон|крыш|сарай|склад|лес|куст|дерев|здани|проводк|щит|счетчик){L}*", "why": "горит мусор/машина/дом — без вето освещения"},
    {"id": "fire_object_before_ru", "kind": "fire", "re": "(?:мусор|мусорка|бак|контейнер|трава|дом|квартира|подъезд|гараж|машина|автомобиль|балкон|крыша|сарай|склад|лес|кусты|деревья|здание|проводка|щит|щиток|счетчик) (?:горит|горят|загорел{L}*|полыхает|полыхают|пылает)", "why": "мусор горит"},
    {"id": "fire_burning_adj_ru", "kind": "fire", "re": "{B}горящ{L}* (?:трав|куст|мусор|лес|дерев|машин|автомобил|дом|бак|контейнер|гараж|сарай|балкон|склад){L}*", "why": "дым от горящей травы, горящий бак"},
    {"id": "fire_burning_ru", "kind": "fire", "re": "{B}(?:горит|горят|горело|горела|горел|загорелся|загорелась|загорелось|загорелись|полыхает|полыхают|пылает){E}", "veto": "свет|фонар|ламп|табло|светофор|освещ|прожектор|подсвет|гирлянд|вывеск|экран|индикатор|шам|жарық", "why": "просто «горит» — только если в тексте нет слов освещения"},
    {"id": "arson_ru", "kind": "fire", "re": "{B}(?:подожгл{L}*|подожг[её]т{L}*|подожж{L}*|поджог{L}*|поджечь)", "why": "подожгли контейнер, поджог (находка сессии B)"},
    {"id": "fire_something_ru", "kind": "fire", "re": "что-? ?то (?:горит|горело|подгорает|загорелось)", "why": "что-то горит"},
    {"id": "smoke_inside_ru", "kind": "fire", "re": "{B}(?:дым|гар[ьи]|гарью|задымлен{L}*)[^.!?]{0,25}(?:в (?:подъезд|подвал|квартир|лифт|коридор|мусоропровод|щитов)|из (?:окн|подъезд|подвал|квартир|мусоропровод|щит)){L}*", "why": "дым/гарь в подъезде, дым из окна — признак пожара в доме; уличная гарь (ТЭЦ, листья) — нет"},
    {"id": "smoke_inside_before_ru", "kind": "fire", "re": "(?:(?:в|из) (?:подъезд|подвал|квартир|лифт|коридор|мусоропровод|щитов)|из окн){L}*[^.!?]{0,40}{B}(?:дым|гар[ьи]|гарью|задымлен{L}*)", "why": "в подъезде пахнет гарью, из окна идёт дым"},
    {"id": "fire_kk", "kind": "fire", "re": "{B}(?:өрт(?:ке|ті|тің|те|тен|пен)?|өртен{L}*){E}", "why": "өрт шықты, үй өртеніп жатыр (после except: не «өрт сөндіру»)"},
    {"id": "burning_kk", "kind": "fire", "re": "{B}жанып (?:жатыр|тұр|кетті){E}", "veto": "шам|жарық|фонар|бағдаршам|табло|свет|ламп", "why": "қоқыс жанып жатыр; «шамдар жанып тұр» — освещение"},
    {"id": "smoke_inside_kk", "kind": "fire", "re": "(?:кіреберіс|подъезд|жертөле|пәтер|терезе|лифт){L}*[^.!?]{0,25}түтін", "why": "кіреберісте түтін"},
    {"id": "fire_translit", "kind": "fire", "re": "{B}pozhar(?:a|e|om|u|y)?{E}", "why": "pozhar"},
    {"id": "burning_translit", "kind": "fire", "re": "{B}(?:gorit|goryat|gorel[ao]?){E}", "veto": "svet|fonar|lamp|tablo|ulichn", "why": "gorit"},

    {"id": "wire_down_ru", "kind": "wire", "re": "{B}(?:провод(?:а|ов|ом|ами|ах|у|е|ка|ки|ку|кой|ке)?|кабел(?:ь|я|ю|ем|е|и|ей|ям|ями|ях)){E}[^.!?]{0,25}(?:оборван|оборвал|обрыв|порван|упал|лежит на земле|лежат на земле|на земле|на асфальте|на тротуаре|искрит|искрят|под напряжением)", "why": "провод оборван / лежит на земле / искрит; «торчат» или «оголены» провода у опоры — нет (обычная жалоба на опору, не «оборван провод»)"},
    {"id": "wire_down_before_ru", "kind": "wire", "re": "(?:оборван|оборвал|обрыв|порван|упал|упавш){L}*[^.!?]{0,25}{B}(?:провод(?:а|ов|ом|ами|ах|у|е|ка|ки|ку|кой|ке)?|кабел(?:ь|я|ю|ем|е|и|ей|ям|ями|ях)){E}", "why": "оборванный провод"},
    {"id": "sparks_ru", "kind": "wire", "re": "{B}(?:искрит|искрят|искрило|искрится|искры){E}", "why": "искрит щиток/провод; не «искренне»"},
    {"id": "shock_ru", "kind": "wire", "re": "(?:бьет|ударил[оа]?|ударит|дернул[оа]?) током|током (?:бьет|ударил[оа]?|дернул[оа]?)", "why": "бьёт током"},
    {"id": "wire_kk", "kind": "wire", "re": "{B}сым(?:ы|ын|дар|дары|дарын|дың|ды|нан|дан|дардың|дарының)?{E}[^.!?]{0,25}(?:үзіл|үзіп|жерде жат|жерге түс|ұшқын){L}*", "why": "сым үзіліп жерде жатыр; «сымдары ашық» (оголённые) и «салбырап» (висят) — без баннера, как ru «торчат/оголены/висят провода»"},
    {"id": "sparks_shock_kk", "kind": "wire", "re": "ұшқын шаш{L}*|ток со(?:ғ|қ){L}*|тоқ со(?:ғ|қ){L}*", "why": "ұшқын шашып тұр, ток соғады"},
    {"id": "wire_translit", "kind": "wire", "re": "{B}provod(?:a|ov|om|ka|ki)?{E}[^.!?]{0,25}(?:oborvan|lezh{L}* na zemle|iskr{L}*)|oborvan{L}*[^.!?]{0,25}provod(?:a|ov|om|ka|ki)?{E}", "why": "provod oborvan"}
  ]
}
