+ATTR_NAMES = {"OpenStreetMap": "© OpenStreetMap contributors", "meta": "Meta", "Foursquare": "Foursquare",
+              "TomTom": "TomTom", "Overture": "Overture Maps Foundation", "Microsoft": "Microsoft",
+              "AllThePlaces": "AllThePlaces", "PinMeTo": "PinMeTo"}
