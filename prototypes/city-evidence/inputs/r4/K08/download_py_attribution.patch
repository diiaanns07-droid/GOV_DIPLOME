+def attribution_from(feats):
+    """Sorted '<provider> (<license>)' lines from sources[] of the given features, plus the Overture release."""
+    lines = {"Overture Maps Foundation (release %s)" % RELEASE}
+    for f in feats:
+        for s in f["properties"].get("sources") or []:
+            lines.add("%s (%s)" % (ATTR_NAMES.get(s.get("dataset"), s.get("dataset")), s.get("license")))
+    return sorted(lines)
+
+
+def licenses_from(feats):
+    return sorted({s.get("license") for f in feats for s in f["properties"].get("sources") or [] if s.get("license")})
+
